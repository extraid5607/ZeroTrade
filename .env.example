# ==============================================================================
# ZeroTrade - Paper Trading Platform Configuration
# ==============================================================================

PORT=8000
SECRET_KEY=zerotrade_super_secret_jwt_key_change_me_in_production_2026

# Virtual initial cash balance given to new traders
INITIAL_VIRTUAL_CASH=100000.00

# US Stocks (Alpaca Paper Trading Data API)
# Free signup at alpaca.markets (email only, no KYC required)
# Uses IEX real-time feed for live US stock quotes
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets/v2
ALPACA_WS_ENDPOINT=wss://stream.data.alpaca.markets/v2/iex

# Crypto (Binance Public API)
# No API key required for public market data and klines
BINANCE_REST_ENDPOINT=https://api.binance.com/api/v3
BINANCE_WS_ENDPOINT=wss://stream.binance.com:9443/ws

# Forex (Twelve Data Free Tier)
# NOTE: Free tier is for development/personal use only (limit: 8 calls/min).
# Upgrade to a commercial paid plan before high-traffic public deployment!
TWELVE_DATA_API_KEY=

# Database URL (defaults to SQLite: data/zerotrade.db if not specified)
# Set to a PostgreSQL connection string on Render (e.g. postgresql://user:pass@host/db)
DATABASE_URL=
